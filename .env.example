# The Lenny Growth Assistant - environment configuration
#
# Copy to .env and adjust. Every value below is a safe local default, so the
# stack runs with no edits at all:
#
#     cp .env.example .env && ./startup.sh
#
# Never commit .env. It is listed in .gitignore.

# ---------------------------------------------------------------------------
# REQUIRED - PostgreSQL
# Defaults work as-is with docker compose. Change the password for any
# deployment reachable beyond your machine.
# ---------------------------------------------------------------------------
POSTGRES_DB=lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password

# ---------------------------------------------------------------------------
# REQUIRED - Local model (Ollama). Mandatory for the demo.
# Both models are pulled automatically by startup.sh.
# ---------------------------------------------------------------------------
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Seconds to wait for a local generation. Raise it on slower hardware: the
# first request after a cold start also pays the model load time.
OLLAMA_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# OPTIONAL - Cloud model (Anthropic Claude)
#
# Leave ANTHROPIC_API_KEY empty to run local-only; the app starts fine without
# it. If it is empty and a request asks for Claude, the backend falls back to
# Ollama and returns the reason in `fallback_reason`, which the UI displays.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Which provider serves requests that do not name one. 'ollama' or 'claude'.
DEFAULT_MODEL=ollama

# ---------------------------------------------------------------------------
# OPTIONAL - Ingestion
#
# Transcripts are fetched from the public Lenny's Podcast transcript repo.
# The default subset gives a working, grounded demo in a few minutes.
# Set INGEST_LIMIT=0 to ingest the full catalogue (slower: every chunk is
# embedded locally through Ollama).
# ---------------------------------------------------------------------------
INGEST_LIMIT=15
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# OPTIONAL - Retrieval tuning
# ---------------------------------------------------------------------------
CHROMA_COLLECTION_NAME=lenny_transcripts
CHUNK_MIN_TOKENS=800
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_TOKENS=200
RETRIEVAL_TOP_K=10
CONTEXT_MAX_TOKENS=4000

# Chunks scoring below this cosine similarity are discarded rather than shown
# as weak citations. Raise it for stricter grounding, lower it for more recall.
MIN_SIMILARITY_SCORE=0.25

# ---------------------------------------------------------------------------
# OPTIONAL - Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where the browser reaches the API. Change if you remap the backend port.
VITE_API_URL=http://localhost:8080
